
/**
 * FIRESTORE SECURITY RULES
 * Version: 2.6
 * SuperAdmin Designation: rielmagpantay@gmail.com
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the designated SuperAdmin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'rielmagpantay@gmail.com';
    }

    // Ports: Publicly readable, writeable only by SuperAdmin
    match /ports/{portId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Routes: Publicly readable, writeable only by SuperAdmin
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Fares: Publicly readable, writeable only by SuperAdmin
    match /fares/{fareId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Vessels: Publicly readable, writeable only by SuperAdmin
    match /vessels/{vesselId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Maintenance: Publicly readable, writeable only by SuperAdmin
    match /maintenance/{recordId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Schedules: Publicly readable, writeable only by SuperAdmin
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Bookings: Publicly readable and writeable (Public/Desk workflow)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Users: 
    // - Any logged-in user can read profiles (supports desk lookup feature).
    // - Users can update their own profile.
    // - SuperAdmin can manage all profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
