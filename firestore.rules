
/**
 * FIRESTORE SECURITY RULES
 * Version: 3.0
 * SuperAdmin Designation: rielmagpantay@gmail.com
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the designated SuperAdmin
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'rielmagpantay@gmail.com';
    }

    // Ports, Routes, Fares, Vessels, Maintenance, Schedules: Public read, Admin write
    match /ports/{portId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /routes/{routeId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /fares/{fareId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /vessels/{vesselId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /maintenance/{recordId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /schedules/{scheduleId} { allow read: if true; allow write: if isSuperAdmin(); }

    // Bookings: Publicly readable and writeable
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // User Profiles:
    // - Authenticated users can read profiles (supports search/lookup features).
    // - A user can create or update their own profile document (matched by UID).
    // - SuperAdmin has unrestricted access to manage any profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
