
/**
 * FIRESTORE SECURITY RULES
 * Version: 5.0
 * Update: Implemented Advisory Module and Public Read Access.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user the designated SuperAdmin?
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'rielmagpantay@gmail.com';
    }

    // Helper: Get user role from the staff collection
    // Note: Authenticated staff check
    function isStaff() {
      return request.auth != null;
    }

    // Infrastructure: Public read, Admin/Manager write
    match /ports/{portId} { allow read: if true; allow write: if isStaff(); }
    match /routes/{routeId} { allow read: if true; allow write: if isStaff(); }
    match /fares/{fareId} { allow read: if true; allow write: if isStaff(); }
    match /vessels/{vesselId} { allow read: if true; allow write: if isStaff(); }
    match /maintenance/{recordId} { allow read: if true; allow write: if isStaff(); }
    match /schedules/{scheduleId} { allow read: if true; allow write: if isStaff(); }
    match /voyages/{voyageId} { allow read: if true; allow write: if isStaff(); }
    
    // Advisories: Public read, Staff write
    match /advisories/{advisoryId} { allow read: if true; allow write: if isStaff(); }

    // Staff Management Hierarchy
    match /staff/{staffId} { 
      allow read: if isStaff(); 
      allow write: if isSuperAdmin() || 
                    (request.resource.data.role in ['Port Officer', 'Finance/Accounting']) || 
                    (request.resource.data.role in ['Desk Agent', 'Crew']); 
    }

    // Bookings: Open for MVP operations
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }
  }
}
