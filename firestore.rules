
/**
 * FIRESTORE SECURITY RULES
 * Version: 3.9
 * Update: Added Staff management for SuperAdmin operations.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the designated SuperAdmin
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'rielmagpantay@gmail.com';
    }

    // Ports, Routes, Fares, Vessels, Maintenance, Schedules, Voyages, Staff: Public read, Admin write
    match /ports/{portId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /routes/{routeId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /fares/{fareId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /vessels/{vesselId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /maintenance/{recordId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /schedules/{scheduleId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /voyages/{voyageId} { allow read: if true; allow write: if isSuperAdmin(); }
    match /staff/{staffId} { allow read: if true; allow write: if isSuperAdmin(); }

    // Bookings: Open for MVP desk/public operations (in production should be restricted)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // User Profiles:
    // - Authenticated users can read profiles for manifest lookups.
    // - Users can manage (write) their own profile document.
    // - SuperAdmin has explicit management authority over all profile documents.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'rielmagpantay@gmail.com');
    }
  }
}
