
{
  "entities": {
    "Port": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Port",
      "type": "object",
      "description": "Represents a maritime port or terminal where vessels can depart from or arrive at. Admin staff can manage these entries.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Port entity."
        },
        "name": {
          "type": "string",
          "description": "The official or common name of the port."
        },
        "cityMunicipality": {
          "type": "string",
          "description": "The city or municipality where the port is located."
        },
        "province": {
          "type": "string",
          "description": "The province where the port is located."
        },
        "country": {
          "type": "string",
          "description": "The country where the port is geographically located."
        },
        "description": {
          "type": "string",
          "description": "A brief description or additional information about the port facilities or location."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the port record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the port record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "cityMunicipality",
        "province",
        "country",
        "createdAt",
        "updatedAt"
      ]
    },
    "Route": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Route",
      "type": "object",
      "description": "Represents a maritime route connecting two ports, including penalty fee configurations.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The name of the route, e.g., Manila - Cebu."
        },
        "originPortId": {
          "type": "string",
          "description": "The ID of the departure port."
        },
        "destinationPortId": {
          "type": "string",
          "description": "The ID of the arrival port."
        },
        "basePrice": {
          "type": "number",
          "description": "The standard fare for this route."
        },
        "estimatedDurationMinutes": {
          "type": "number",
          "description": "Estimated time for the voyage in minutes."
        },
        "rebookingFee": {
          "type": "number",
          "default": 0,
          "description": "Fee charged for rebooking a ticket on this route."
        },
        "cancellationFee": {
          "type": "number",
          "default": 0,
          "description": "Fee charged for cancelling a confirmed booking."
        },
        "noShowFee": {
          "type": "number",
          "default": 0,
          "description": "Penalty for passengers who fail to board."
        },
        "passengerSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string", "description": "Segment name, e.g., Senior, Student, PWD." }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "originPortId",
        "destinationPortId",
        "basePrice",
        "createdAt",
        "updatedAt"
      ]
    },
    "Fare": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Fare",
      "type": "object",
      "description": "Detailed fare configuration for a specific route and passenger segment.",
      "properties": {
        "id": { "type": "string" },
        "routeId": { "type": "string" },
        "segmentId": { "type": "string" },
        "segmentLabel": { "type": "string" },
        "baseFare": { "type": "number" },
        "isVatExempt": { "type": "boolean" },
        "vatRate": { "type": "number", "default": 0.12 },
        "discountPercentage": { "type": "number", "enum": [0, 20, 50, 100] },
        "finalFare": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "routeId", "segmentId", "baseFare", "finalFare"]
    },
    "Vessel": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vessel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["RoRo", "FastCraft", "Cargo Ship", "Catamaran"] },
        "passengerCapacity": { "type": "number" },
        "cargoCapacityTEU": { "type": "number" },
        "status": { "type": "string", "enum": ["Operational", "Maintenance", "Out of Service"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "status"]
    },
    "MaintenanceRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MaintenanceRecord",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vesselId": { "type": "string" },
        "description": { "type": "string" },
        "scheduledDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Scheduled", "In Progress", "Completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "vesselId", "description", "scheduledDate", "status"]
    },
    "TripSchedule": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TripSchedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripCode": { "type": "string", "description": "User-defined trip code, e.g. ML-101." },
        "routeId": { "type": "string" },
        "vesselId": { "type": "string", "description": "ID of the assigned vessel. Optional if assignment is pending." },
        "departureTime": { "type": "string", "description": "Time in HH:mm format" },
        "arrivalTime": { "type": "string", "description": "Estimated arrival time in HH:mm format" },
        "passengerCapacity": { "type": "number", "description": "Seat capacity for this specific schedule." },
        "waitlistLimit": { "type": "number", "default": 10, "description": "Maximum number of waitlisted passengers allowed." },
        "type": { "type": "string", "enum": ["Daily", "Special"] },
        "specialDates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tripCode", "routeId", "departureTime", "type", "passengerCapacity"]
    },
    "VoyageStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "VoyageStatus",
      "type": "object",
      "description": "Real-time status tracking and atomic inventory for a voyage instance.",
      "properties": {
        "id": { "type": "string", "description": "Format: scheduleId_YYYY-MM-DD" },
        "scheduleId": { "type": "string" },
        "vesselId": { "type": "string", "description": "ID of the vessel assigned for this specific instance." },
        "travelDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Scheduled", "On-time", "Delayed", "Departed", "Arrived", "Cancelled"] },
        "bookedCount": { "type": "number", "default": 0, "description": "Atomic counter for confirmed/reserved seats." },
        "waitlistCount": { "type": "number", "default": 0, "description": "Atomic counter for waitlisted passengers." },
        "remarks": { "type": "string" },
        "actualDeparture": { "type": "string", "format": "date-time" },
        "actualArrival": { "type": "string", "format": "date-time" },
        "compliance": {
          "type": "object",
          "properties": {
            "sanitationChecked": { "type": "boolean", "default": false },
            "safetyGearChecked": { "type": "boolean", "default": false },
            "stabilityConfirmed": { "type": "boolean", "default": false },
            "headcountVerified": { "type": "boolean", "default": false },
            "vesselClear": { "type": "boolean", "default": false },
            "logbookFinalized": { "type": "boolean", "default": false },
            "manifestCleared": { "type": "boolean", "default": false }
          }
        },
        "clearance": {
          "type": "object",
          "properties": {
            "captainName": { "type": "string" },
            "captainLicense": { "type": "string" },
            "coastGuardOfficer": { "type": "string" },
            "coastGuardRank": { "type": "string" },
            "clearedAt": { "type": "string", "format": "date-time" }
          }
        },
        "auditLogs": {
          "type": "object",
          "description": "Stores verification metadata for compliance checks.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "verifiedBy": { "type": "string" },
              "verifiedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "scheduleId", "travelDate", "status"]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a ticket booking made at the desk or online.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "scheduleId": { "type": "string" },
        "routeId": { "type": "string" },
        "fareId": { "type": "string" },
        "travelDate": { "type": "string", "format": "date" },
        "passengerName": { "type": "string" },
        "passengerDob": { "type": "string", "format": "date" },
        "passengerEmail": { "type": "string", "format": "email" },
        "passengerContact": { "type": "string", "description": "Mobile number of the passenger." },
        "emergencyContact": { "type": "string", "description": "Emergency mobile number." },
        "segmentLabel": { "type": "string" },
        "finalFare": { "type": "number" },
        "status": { "type": "string", "enum": ["Reserved", "Waitlisted", "Confirmed", "Used", "Suspended", "Auto-cancelled", "Refunded"] },
        "bookingSource": { "type": "string", "enum": ["Desk", "Public"] },
        "boardingSequenceNumber": { "type": "number" },
        "rebookedFromId": { "type": "string", "description": "Original booking ID if this is a rebooked ticket." },
        "penaltyFees": { "type": "number", "default": 0 },
        "isFeeWaived": { "type": "boolean", "default": false },
        "waiveReason": { "type": "string", "enum": ["Weather", "Technical", "Force Majeure", "Passenger Request"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "scheduleId", "routeId", "passengerName", "passengerDob", "passengerContact", "emergencyContact", "finalFare", "status"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "emergencyContact": { "type": "string" },
        "familyMembers": {
          "type": "array",
          "items": {
            "object": {
              "properties": {
                "id": { "type": "string" },
                "fullName": { "type": "string" },
                "birthDate": { "type": "string", "format": "date" },
                "emergencyContact": { "type": "string" }
              }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Staff": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Staff",
      "type": "object",
      "description": "Represents an internal staff member of the maritime operation.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Operations Manager", "Port Officer", "Desk Agent", "Crew", "Finance/Accounting"] },
        "crewRole": { "type": "string", "enum": ["Captain", "Engineer", "Deckhand"], "description": "Specific functional role for crew members." },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "assignedPortIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of the ports this staff member is assigned to." },
        "assignedVesselId": { "type": "string", "description": "ID of the vessel (ship) this staff member is primarily assigned to." },
        "authorizedModules": { "type": "array", "items": { "type": "string" }, "description": "Custom list of modules this staff member can access." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "status"]
    },
    "Advisory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Advisory",
      "type": "object",
      "description": "A public announcement or alert displayed on the home page and advisories board.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["Weather", "Service Disruption", "Route/Fare Change", "General Information"] },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "isActive": { "type": "boolean", "default": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "category", "severity"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/ports/{portId}",
        "definition": {
          "entityName": "Port",
          "schema": {
            "$ref": "#/backend/entities/Port"
          },
          "description": "A top-level collection containing all maritime port definitions."
        }
      },
      {
        "path": "/routes/{routeId}",
        "definition": {
          "entityName": "Route",
          "schema": {
            "$ref": "#/backend/entities/Route"
          },
          "description": "A top-level collection containing maritime route definitions."
        }
      },
      {
        "path": "/fares/{fareId}",
        "definition": {
          "entityName": "Fare",
          "schema": {
            "$ref": "#/backend/entities/Fare"
          },
          "description": "A collection containing fare pricing rules for route segments."
        }
      },
      {
        "path": "/vessels/{vesselId}",
        "definition": {
          "entityName": "Vessel",
          "schema": {
            "$ref": "#/backend/entities/Vessel"
          },
          "description": "A collection of vessels in the fleet."
        }
      },
      {
        "path": "/maintenance/{recordId}",
        "definition": {
          "entityName": "MaintenanceRecord",
          "schema": {
            "$ref": "#/backend/entities/MaintenanceRecord"
          },
          "description": "Historical and scheduled maintenance records for vessels."
        }
      },
      {
        "path": "/schedules/{scheduleId}",
        "definition": {
          "entityName": "TripSchedule",
          "schema": {
            "$ref": "#/backend/entities/TripSchedule"
          },
          "description": "Daily and special trip schedules for maritime routes."
        }
      },
      {
        "path": "/voyages/{voyageId}",
        "definition": {
          "entityName": "VoyageStatus",
          "schema": {
            "$ref": "#/backend/entities/VoyageStatus"
          },
          "description": "Date-specific status tracking and atomic inventory for voyages."
        }
      },
      {
        "path": "/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": {
            "$ref": "#/backend/entities/Booking"
          },
          "description": "Records of passenger bookings and ticket sales."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores individual user profile data."
        }
      },
      {
        "path": "/staff/{staffId}",
        "definition": {
          "entityName": "Staff",
          "schema": {
            "$ref": "#/backend/entities/Staff"
          },
          "description": "Internal staff registry managed by SuperAdmin."
        }
      },
      {
        "path": "/advisories/{advisoryId}",
        "definition": {
          "entityName": "Advisory",
          "schema": {
            "$ref": "#/backend/entities/Advisory"
          },
          "description": "Public announcements and alerts."
        }
      }
    ]
  }
}
